#!/bin/bash
# ExecStartPost of soloist.service: fails when Soloist hasn't logged in 30 s after
# starting. A failed login leaves Soloist running but useless (it never retries);
# failing the start makes systemd restart it (Restart=on-failure).
soloist=$HOME/.local/opt/soloist/soloist
for _ in $(seq 30); do
    timeout 5 "$soloist" ctl status 2>/dev/null | grep -q 'logged in: yes' && exit 0
    sleep 1
done
echo "Soloist isn't logged in 30 s after starting; restarting it"
exit 1
